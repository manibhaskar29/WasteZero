# -------------------------
# Server
# -------------------------
PORT=5173

# -------------------------
# MongoDB (Atlas)
# -------------------------
MONGO_URI="MONGO DB ATLAS URI"

# -------------------------
# JWT
# -------------------------
JWT_SECRET="RANDOM KEY"
JWT_EXPIRES_IN=1h

# -------------------------
# Frontend URL
# (the React app URL where the frontend runs)
# -------------------------
FRONTEND_URL=http://localhost:3000

# -------------------------
# SMTP / Email (for password reset)
# Example below uses Gmail SMTP
# -------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="YOUR EMAIL-ID"
SMTP_PASS="SMTP PASSWORD"
EMAIL_FROM=WasteZero "YOUR EMAIL-ID"

# -------------------------
# OAuth (Google + GitHub)
# -------------------------
GOOGLE_CLIENT_ID="GOOGLE CLIENT ID"
GOOGLE_CLIENT_SECRET="SECRET KEY"

GITHUB_CLIENT_ID="GITHUB CLIENT ID"
GITHUB_CLIENT_SECRET="SECRET KEY"

# OAuth callback base (backend URL)
OAUTH_CALLBACK_BASE=http://localhost:5173/api/auth/oauth/callback

# -------------------------
# Cookie key (for session)
# -------------------------
COOKIE_KEY="RANDOM KEY"

